# ============================================================
#  قالب متغيرات البيئة للإنتاج (Appliku / Hetzner)
#  انسخ هذه القيم في Appliku Dashboard > App > Environment
#  لا ترفع ملف .env الحقيقي إلى Git أبداً
# ============================================================

# --- الأساسيات ---
# مفتاح جديد مختلف عن مفتاح التطوير!
SECRET_KEY=generate-a-new-random-key-here
DEBUG=False

# دومينك + نطاق Appliku المؤقت (يظهر بعد إنشاء التطبيق)
ALLOWED_HOSTS=sayarti.org,www.sayarti.org,yourapp.appliku.so

# غيّر مسار لوحة التحكم ولا تتركه admin/ في الإنتاج
ADMIN_URL=site-control-2026/

# روابط موثوقة لنماذج POST - ضع نفس الدومينات مع https
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- الأمان الكامل (بعد تأكد أن SSL يعمل) ---
PROD_SECURE=True
SECURE_HSTS_SECONDS=31536000

# --- قاعدة البيانات (Appliku يعطيك هذا الرابط عند إنشاء PostgreSQL) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- النسخ الاحتياطي اليومي ---
# يجب أن يكون المستودع خاصاً. السكربت يرفع نسخة مشفرة إذا ضبطت passphrase.
BACKUP_GITHUB_REPO=your-github-user/sayarti-full-backup
GITHUB_BACKUP_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
BACKUP_ENCRYPTION_PASSPHRASE=use-a-long-random-passphrase
BACKUP_KEEP_LAST=7
# لا تستخدم هذه إلا مؤقتاً للاختبار المحلي.
BACKUP_ALLOW_LOCAL_ONLY=False
BACKUP_ALLOW_UNENCRYPTED=False

# --- الذكاء الاصطناعي ---
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# كاش أسعار "شكد فلوسك" داخل قاعدة البيانات يتجدد تلقائياً من الكود كل 10 أيام.
# لا تجعله طويلاً جداً لأن أسعار السيارات تتغير.

# --- البريد (Gmail مثال) - اختياري ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=app-password-here
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --- تخزين صور البنرات على Hetzner Object Storage (موصى به) ---
# أنشئ Bucket من وحدة تحكم Hetzner Cloud > Object Storage
USE_S3=True
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=sayarti-media
AWS_S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
AWS_S3_REGION_NAME=fsn1
